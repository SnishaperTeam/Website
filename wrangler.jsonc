{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jetcpppages",
  "compatibility_date": "2026-05-14",
  "pages_build_output_dir": "build/vue-app/dist",   // 新增这一行！
  "observability": {
    "enabled": true
  },
  // 下面的 assets 和 build 字段对 pages deploy 无影响，可以保留
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": {
    "upload": {
      "exclude": [
        "node_modules/**/*",
        "**/node_modules/**/*",
        "supabase/bin/supabase",
        "**/supabase/bin/supabase",
        "*.exe"
      ]
    }
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}