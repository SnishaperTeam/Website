{
  "name": "snishaperteam-website",
  "version": "1.0.0",
  "description": "SnishaperTeam Website",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.js",
    "dev:api": "bun scripts/dev-api.js",
    "prebuild": "",
    "build": "bun run generate-rss && bun run --bun vite build && bun run deploy",
    "deploy": "bun scripts/deploy.js && bun -e \"import fs from 'fs'; fs.copyFileSync('dist/index.html', 'dist/404.html')\"",
    "preview": "bun run --bun vite preview",
    "generate-rss": "bun scripts/generate-rss.js",
    "add-project": "bun scripts/add-content.js project",
    "add-blog": "bun scripts/add-content.js blog"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify/vue": "^5.0.5",
    "bootstrap": "^5.3.8",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "tsx": "^4.23.15"
  }
}
