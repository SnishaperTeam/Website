# Supabase 配置（必需）
# 从 Supabase Dashboard → Settings → API 获取
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 管理员配置（可选）
# 设置管理员邮箱，该邮箱的用户将拥有管理员权限
VITE_ADMIN_EMAIL=your-admin-email@example.com

# Turnstile（可选）
# 从 Cloudflare Dashboard → Turnstile 获取
VITE_TURNSTILE_SITEKEY=0x4AAAAAAD9eupJAQYJfXjdp

# 使用说明：
# 1. 复制此文件为 .env.local
# 2. 替换所有占位符为实际值
# 3. .env.local 已被 .gitignore 忽略，不会提交到 Git
# 4. 永远不要将包含真实密钥的文件上传到公开仓库
